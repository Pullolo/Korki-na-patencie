# Skopiuj brakujące wpisy do .env.local (ten plik jest tylko wzorem).

# ─── Baza danych (PostgreSQL) ─────────────────────────────────────────────────
# Zgodne z docker-compose.yml w repo: `docker compose up -d db`
DATABASE_URL="postgresql://korki:korki@localhost:5432/korki"

# ─── Clerk — https://dashboard.clerk.com ──────────────────────────────────────
# Te dwa klucze wpisał już Clerk CLI podczas `clerk init`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Aplikacja ────────────────────────────────────────────────────────────────
# OBOWIĄZKOWE na produkcji. Bez tego canonical, mapa witryny, obrazy OG
# i linki w mailach wskazują na localhost — a nikt tego nie zauważy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Poczta transakcyjna (Resend) ─────────────────────────────────────────────
# Bez tych dwóch wpisów serwis działa, ale NIC nie wysyła: uczeń nie dostanie
# kodu rezerwacji, a nauczyciel — informacji o nowym zgłoszeniu.
# `EMAIL_FROM` musi być adresem z domeny zweryfikowanej w Resendzie.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Korki na patencie <kontakt@twoja-domena.pl>"

# ─── Formularze publiczne ─────────────────────────────────────────────────────
# Klucz do podpisywania znaczników czasu w formularzach (anty-bot).
# Gdy pusty, używany jest CLERK_SECRET_KEY z domieszką rozdzielającą role.
# FORM_SECRET=

# ─── Stripe (etap 5, na razie nieużywane) ─────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
